flowchart LR
    user([User])

    subgraph entries["Desktop and Browser Entries"]
        main["main.py<br/>desktop launcher"]
        flask_thread["Flask server thread<br/>127.0.0.1"]
        pywebview["pywebview native window"]
        app_entry["app.py<br/>browser and Flask entry"]
    end

    subgraph frontend["Frontend SPA"]
        spa["frontend/index.html<br/>single-page application"]
        router["frontend/js/router.js<br/>hash route to page objects"]
        pages["Page components<br/>login, downloads, history, settings"]
        api_client["frontend/js/api.js<br/>fetch wrapper"]
    end

    subgraph flask["Flask API Layer"]
        registry["app.py blueprint registry"]
        blueprints["backend/*.py Flask blueprints<br/>articles, accounts, platform APIs"]
    end

    subgraph domain["Shared Domain Infrastructure"]
        runtime["backend/runtime.py<br/>frozen and source paths"]
        config["backend/config.py<br/>settings, proxies, storage paths"]
        account_pool["backend/account_pool.py<br/>WeChat Reading credential scheduling"]
        rss["backend/rss_scheduler.py<br/>background fetch and upload"]
        downloader["backend/downloader.py<br/>article and resource downloads"]
        proxy_manager["backend/mitm_proxy.py<br/>traffic interception"]
        transcode["backend/transcode.py<br/>media conversion"]
    end

    subgraph clients["Platform Clients"]
        mp_client["WeChat MP article clients"]
        reading_client["WeChat Reading client"]
        channels_client["backend/channels.py<br/>WeChat Channels client"]
        video_clients["Douyin, Kuaishou,<br/>Xiaohongshu, Bilibili clients"]
    end

    subgraph automation["Browser and Injection Runtime"]
        playwright["Playwright<br/>persistent Chromium contexts"]
        mitmproxy["mitmproxy<br/>HTTPS interception"]
        injection["injection_scripts/src/*<br/>Channels UI and automation hooks"]
    end

    subgraph storage["Storage and Media Tools"]
        settings_store["settings and proxy state"]
        account_store["credential pool storage"]
        file_store["downloads and uploads"]
        history_store["history databases"]
        ffmpeg["ffmpeg / ffprobe"]
    end

    subgraph external["External Sites and Services"]
        wechat["WeChat MP, Reading,<br/>and Channels"]
        media_sites["Douyin, Kuaishou,<br/>Xiaohongshu, Bilibili"]
        cdn["media CDNs"]
    end

    subgraph packaging["Packaging Pipeline"]
        spec["wechat_mp_tools.spec"]
        actions[".github/workflows/build.yml"]
        artifacts["Full and Lite release archives"]
    end

